{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PP Clash",
  "version": "0.2.4",
  "identifier": "com.ppclash.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PP Clash",
        "width": 1120,
        "height": 780,
        "minWidth": 1060,
        "minHeight": 700,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "targets": [
      "app"
    ],
    "resources": {
      "resources/kernel.zip": "resources/kernel.zip",
      "resources/sub-store/": "sub-store/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
