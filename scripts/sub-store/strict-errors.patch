@@ -0,0 +1,61 @@
+import { parse } from 'acorn';
+
+function bindsName(pattern, name) {
+    if (!pattern) return false;
+    if (pattern.type === 'Identifier') return pattern.name === name;
+    if (pattern.type === 'RestElement') return bindsName(pattern.argument, name);
+    if (pattern.type === 'AssignmentPattern') return bindsName(pattern.left, name);
+    if (pattern.type === 'ArrayPattern') {
+        return pattern.elements.some((item) => bindsName(item, name));
+    }
+    if (pattern.type === 'ObjectPattern') {
+        return pattern.properties.some((item) =>
+            bindsName(item.type === 'RestElement' ? item.argument : item.value, name),
+        );
+    }
+    return false;
+}
+
+// Decide before executing user code. Comments, strings and exceptions are not
+// evidence of a script mode, and nested functions do not declare its entry point.
+export function hasScriptEntryPoint(script, name) {
+    const ast = parse(script, {
+        ecmaVersion: 'latest',
+        sourceType: 'script',
+        allowReturnOutsideFunction: true,
+        allowAwaitOutsideFunction: true,
+    });
+    const functionTypes = new Set(['FunctionExpression', 'ArrowFunctionExpression', 'ClassDeclaration', 'ClassExpression']);
+    function lexicalBinding(node) {
+        if (!node) return false;
+        if (node.type === 'VariableDeclaration') {
+            return node.kind !== 'var' && node.declarations.some(d => bindsName(d.id, name));
+        }
+        return node.type === 'FunctionDeclaration' && bindsName(node.id, name);
+    }
+    function visit(node, shadowed = false, root = false) {
+        if (!node || typeof node !== 'object') return false;
+        if (Array.isArray(node)) return node.some(item => visit(item, shadowed));
+        if (functionTypes.has(node.type)) return false;
+        if (node.type === 'FunctionDeclaration') return root && bindsName(node.id, name);
+        if (node.type === 'VariableDeclaration') {
+            if ((node.kind === 'var' || root) && node.declarations.some(d => bindsName(d.id, name))) return true;
+        }
+        if (node.type === 'AssignmentExpression' && !shadowed && bindsName(node.left, name)) return true;
+        if (node.type === 'Program') return node.body.some(item => visit(item, false, true));
+        if (node.type === 'BlockStatement' || node.type === 'SwitchStatement') {
+            const body = node.type === 'BlockStatement' ? node.body : node.cases.flatMap(item => item.consequent);
+            const local = shadowed || body.some(lexicalBinding);
+            return body.some(item => visit(item, local));
+        }
+        if (node.type === 'ForStatement' || node.type === 'ForOfStatement' || node.type === 'ForInStatement') {
+            const local = shadowed || lexicalBinding(node.init || node.left);
+            return Object.values(node).some(value => visit(value, local));
+        }
+        if (node.type === 'CatchClause') {
+            return visit(node.body, shadowed || bindsName(node.param, name));
+        }
+        return Object.values(node).some(value => visit(value, shadowed));
+    }
+    return visit(ast);
+}
