@@ -0,0 +1,25 @@
+// Processing failures must not be converted into remote-source fallbacks.
+export class ProcessorError extends Error {
+    constructor(message, cause) {
+        super(message);
+        this.name = 'ProcessorError';
+        this.code = 'PROCESSOR_FAILED';
+        this.cause = cause;
+        if (cause instanceof ProcessorError && cause.processor) {
+            this.processor = cause.processor;
+        }
+    }
+}
+
+export function isProcessorError(error) {
+    return error instanceof ProcessorError;
+}
+
+// The caller owns the kind; user names and unknown fields are not discriminators.
+export function processorScope(executionContext) {
+    const scope = executionContext?.processorScope;
+    if (scope && ['sub', 'collection', 'file'].includes(scope.kind) &&
+        typeof scope.name === 'string') {
+        return { kind: scope.kind, name: scope.name };
+    }
+}
