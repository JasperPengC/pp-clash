+++ b/backend/src/core/proxy-utils/processor-trace.js
@@ -0,0 +1,99 @@
+// A preview owns one collector; only callers explicitly carrying it can record.
+// Keep identities intact. Bounds apply while collecting, including concurrent chains.
+const MAX_STEPS = 200;
+const MAX_CHARACTERS = 8000;
+
+export function createProcessorTrace() {
+    const trace = { version: 1, chains: [], truncated: false };
+    const size = () => JSON.stringify(trace).length;
+    const count = () => trace.chains.reduce((sum, chain) => sum + chain.steps.length, 0);
+    const fits = () => count() <= MAX_STEPS && size() <= MAX_CHARACTERS;
+    const oversized = (scope, step) =>
+        scope.name.length + (step?.type?.length || 0) + (step?.name?.length || 0) > MAX_CHARACTERS;
+
+    function removeOrdinaryStep(preferredChain) {
+        for (let i = trace.chains.length - 1; i >= 0; i--) {
+            const chain = trace.chains[i];
+            for (let j = chain.steps.length - 1; j >= 0; j--) {
+                if (chain.steps[j].status !== 'failed') {
+                    chain.steps.splice(j, 1);
+                    return true;
+                }
+            }
+            if (chain !== preferredChain && chain.steps.length === 0) {
+                trace.chains.splice(i, 1);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    return {
+        enter(scope) {
+            if (!scope) return;
+            const chain = { scope: { ...scope }, steps: [] };
+            if (oversized(scope)) {
+                trace.truncated = true;
+                return chain;
+            }
+            trace.chains.push(chain);
+            if (!fits()) {
+                trace.chains.pop();
+                trace.truncated = true;
+            }
+            return chain;
+        },
+        record(chain, step) {
+            if (!chain) return;
+            if (typeof step.type !== 'string' || oversized(chain.scope, step)) {
+                trace.truncated = true;
+                return;
+            }
+            const attached = trace.chains.includes(chain);
+            if (!attached) {
+                if (step.status !== 'failed') {
+                    trace.truncated = true;
+                    return;
+                }
+                trace.chains.push(chain);
+            }
+            chain.steps.push(step);
+            if (!fits()) {
+                trace.truncated = true;
+                if (step.status === 'failed') {
+                    while (!fits() && removeOrdinaryStep(chain)) { /* retain failures first */ }
+                }
+                if (!fits()) {
+                    chain.steps.splice(chain.steps.indexOf(step), 1);
+                    if (!attached && chain.steps.length === 0) {
+                        trace.chains.splice(trace.chains.indexOf(chain), 1);
+                    }
+                }
+            }
+        },
+        snapshot() {
+            return JSON.parse(JSON.stringify(trace));
+        },
+    };
+}
+
+export function processorStep(item, index) {
+    return {
+        index,
+        type: item.type,
+        ...(typeof item.customName === 'string' && item.customName
+            ? { name: item.customName }
+            : {}),
+    };
+}
+
+export function processorTime() {
+    return typeof performance !== 'undefined' && typeof performance.now === 'function'
+        ? performance.now()
+        : Date.now();
+}
+
+export function processorDuration(start) {
+    const elapsed = processorTime() - start;
+    return Number.isFinite(elapsed) ? Math.max(0, elapsed) : 0;
+}
