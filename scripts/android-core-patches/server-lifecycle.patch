+	serverMux.Lock()
+	defer serverMux.Unlock()
+	// Invalidate before closing sockets. Wait for entered parsing/mutations,
+	// not request decoding or raw configuration file reads.
+	mutationMux.Lock()
+	if serverGeneration != nil {
+		serverGeneration.active = false
+	}
+	generation := &controllerGeneration{active: true}
+	serverGeneration = generation
+	mutationMux.Unlock()
+	start(cfg, generation)
+	startTLS(cfg, generation)
+	startUnix(cfg, generation)
 	if inbound.SupportNamedPipe {
-		go startPipe(cfg)
+		startPipe(cfg, generation)
 	}
 }
 
