+// Each router retains its generation even when parsing outlives its server.
+// mutationMux guards generation validity and the entire PATCH/PUT mutation.
+type controllerGeneration struct {
+	active bool
+}
+
+func (generation *controllerGeneration) beginMutation(w http.ResponseWriter, r *http.Request) bool {
+	mutationMux.Lock()
+	if generation == nil || !generation.active {
+		mutationMux.Unlock()
+		render.Status(r, http.StatusServiceUnavailable)
+		render.JSON(w, r, newError("controller generation is no longer active"))
+		return false
+	}
+	return true
+}
